                    "إِيَّاكَ نَعْبُدُ وَإِيَّاكَ نَسْتَعِينُ",
                    "اهْدِنَا الصِّرَاطَ الْمُسْتَقِيمَ",
                    "صِرَاطَ الَّذِينَ أَنْعَمْتَ عَلَيْهِمْ غَيْرِ الْمَغْضُوبِ عَلَيْهِمْ وَلَا الضَّالِّينَ"
                ]},
                { number: 2, name: "البقرة", englishName: "Al-Baqara", type: "مدنية", ayat: [
                    "بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ",
                    "الم",
                    "ذَلِكَ الْكِتَابُ لَا رَيْبَ فِيهِ هُدًى لِلْمُتَّقِينَ",
                    "الَّذِينَ يُؤْمِنُونَ بِالْغَيْبِ وَيُقِيمُونَ الصَّلَاةَ وَمِمَّا رَزَقْنَاهُمْ يُنْفِقُونَ"
                ]},
                { number: 36, name: "يس", englishName: "Ya-Seen", type: "مكية", ayat: [
                    "بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ",
                    "يسٓ",
                    "وَالْقُرْآنِ الْحَكِيمِ",
                    "إِنَّكَ لَمِنَ الْمُرْسَلِينَ",
                    "عَلَى صِرَاطٍ مُسْتَقِيمٍ"
                ]}
            ]
        };

        // App state
        let currentSection = 'sahifa';
        let currentId = 's1';
        let currentFontSize = 22;

        // Initialize App on Load
        window.onload = function() {
            // Check stored theme
            if (localStorage.getItem('theme') === 'dark' || (!localStorage.getItem('theme') && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
                document.documentElement.classList.add('dark');
                document.getElementById('themeIcon').className = 'fa-solid fa-sun';
            }
            switchSection('sahifa');
        };

        // Switch Section Tabs
        function switchSection(section) {
            currentSection = section;
            ['sahifa', 'adiyat', 'ziyarat', 'quran'].forEach(s => {
                const btn = document.getElementById('btn-' + s);
                if (btn) {
                    if (s === section) {
                        btn.className = "flex-1 py-2 px-1 rounded-lg text-center transition text-emerald-700 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-950/40 font-bold";
                    } else {
                        btn.className = "flex-1 py-2 px-1 rounded-lg text-center transition text-slate-600 dark:text-slate-400 hover:bg-slate-200/50 dark:hover:bg-slate-800";
                    }
                }
            });
            renderItemList();
            // Automatically open first item
            if (section === 'quran') {
                openQuranSurah(1);
            } else if (db[section] && db[section].length > 0) {
                openItem(db[section][0].id);
            }
        }

        // Render Sidebar Item List
        function renderItemList(filter = '') {
            const listEl = document.getElementById('itemList');
            listEl.innerHTML = '';
            
            if (currentSection === 'quran') {
                const filtered = db.quran.filter(q => q.name.includes(filter) || q.englishName.toLowerCase().includes(filter.toLowerCase()));
                filtered.forEach(q => {
                    listEl.innerHTML += `
                        <div onclick="openQuranSurah(${q.number})" class="p-3 rounded-xl cursor-pointer transition flex items-center justify-between hover:bg-slate-100 dark:hover:bg-slate-800 border border-transparent hover:border-slate-200 dark:hover:border-slate-700">
                            <div class="flex items-center space-x-3 space-x-reverse">
                                <span class="w-8 h-8 rounded-lg bg-emerald-100 dark:bg-emerald-900/50 text-emerald-700 dark:text-emerald-300 flex items-center justify-center text-xs font-bold">${q.number}</span>
                                <div>
                                    <h4 class="font-bold text-sm font-arabic">سورة ${q.name}</h4>
                                    <span class="text-xs text-slate-400">${q.type}</span>
                                </div>
                            </div>
                            <i class="fa-solid fa-chevron-left text-xs text-slate-400"></i>
                        </div>
                    `;
                });
            } else {
                const items = db[currentSection] || [];
                const filtered = items.filter(i => i.title.includes(filter) || i.text.includes(filter));
                filtered.forEach(item => {
                    const isActive = currentId === item.id;
                    listEl.innerHTML += `
                        <div onclick="openItem('${item.id}')" class="p-3 rounded-xl cursor-pointer transition flex items-center justify-between ${isActive ? 'bg-emerald-50 dark:bg-emerald-950/60 border border-emerald-200 dark:border-emerald-800/50 text-emerald-900 dark:text-emerald-300' : 'hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300'}">
                            <div class="flex-1 pr-2">
                                <h4 class="font-bold text-sm font-arabic">${item.title}</h4>
                            </div>
                            <i class="fa-solid fa-chevron-left text-xs text-slate-400"></i>
                        </div>
                    `;
                });
            }
        }

        // Open specific item in reader
        function openItem(id) {
            currentId = id;
            const item = db[currentSection].find(i => i.id === id);
            if (!item) return;

            document.getElementById('contentTitle').innerText = item.title;
            const subMap = { sahifa: 'قسم الصحيفة السجادية', adiyat: 'قسم الأدعية المستحبة', ziyarat: 'قسم الزيارات الشريفة' };
            document.getElementById('contentSubtitle').innerText = subMap[currentSection] || '';

            document.getElementById('textContent').innerHTML = `
                <h2 class="text-2xl font-bold font-arabic text-emerald-800 dark:text-emerald-400 mb-6 pb-4 border-b border-slate-200 dark:border-slate-800">${item.title}</h2>
                <div class="arabic-text text-slate-800 dark:text-slate-200 space-y-4" style="font-size: ${currentFontSize}px;">
                    ${item.text}
                </div>
            `;
            renderItemList(document.getElementById('globalSearch').value);
            // Close mobile sidebar if open
            document.getElementById('sidebar').classList.add('translate-x-full');
            document.getElementById('sidebarBackdrop').classList.add('hidden');
        }

        // Open Quran Surah
        function openQuranSurah(surahNum) {
            const q = db.quran.find(s => s.number === surahNum);
            if (!q) return;

            document.getElementById('contentTitle').innerText = `سورة ${q.name}`;
            document.getElementById('contentSubtitle').innerText = `القرآن الكريم - ${q.type}`;

            let ayatHtml = `<div class="text-center font-arabic text-xl text-emerald-700 dark:text-emerald-400 mb-6 pb-4 border-b border-slate-200 dark:border-slate-800">بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ</div>`;
            ayatHtml += `<div class="space-y-4 arabic-text text-slate-800 dark:text-slate-200" style="font-size: ${currentFontSize}px;">`;
            q.ayat.forEach((ayah, index) => {
                ayatHtml += `<p class="leading-loose"><span class="text-xs text-gold-600 dark:text-gold-400 font-sans ml-2">[${index + 1}]</span> ${ayah}</p>`;
            });
            ayatHtml += `</div>`;

            document.getElementById('textContent').innerHTML = ayatHtml;
            document.getElementById('sidebar').classList.add('translate-x-full');
            document.getElementById('sidebarBackdrop').classList.add('hidden');
        }

        // Search Input Handler
        function handleSearch(query) {
            renderItemList(query);
        }

        // Font Size Adjuster
        function adjustFontSize(delta) {
            currentFontSize = Math.max(16, Math.min(36, currentFontSize + delta));
            document.getElementById('fontSizeIndicator').innerText = currentFontSize + 'px';
            const readerText = document.querySelector('#textContent .arabic-text');
            if (readerText) {
                readerText.style.fontSize = currentFontSize + 'px';
            }
        }

        // Theme Toggle (Dark / Light Mode)
        function toggleTheme() {
            const html = document.documentElement;
            html.classList.toggle('dark');
            const isDark = html.classList.contains('dark');
            localStorage.setItem('theme', isDark ? 'dark' : 'light');
            document.getElementById('themeIcon').className = isDark ? 'fa-solid fa-sun' : 'fa-solid fa-moon';
        }

        // Mobile Sidebar Toggle
        function toggleMobileSidebar() {
            const sidebar = document.getElementById('sidebar');
            const backdrop = document.getElementById('sidebarBackdrop');
            sidebar.classList.toggle('translate-x-full');
            backdrop.classList.toggle('hidden');
        }
    </script>
</body>
</html>